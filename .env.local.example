# Copy this file to .env.local and fill in the Google OAuth client values.
# Generate AUTH_SECRET with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional but recommended for production. Comma-separated Google account emails allowed into /admin.
# If empty, any signed-in Google account can access /admin.
ADMIN_EMAILS=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_system
